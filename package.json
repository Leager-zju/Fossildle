{
  "name": "fossildle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright install chromium",
    "calibrate": "tsx scripts/calibrate.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:secret": "wrangler secret put",
    "worker:migrate": "wrangler d1 migrations apply fossildle-rank --remote",
    "worker:migrate:local": "wrangler d1 migrations apply fossildle-rank --local"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "^4.144.0"
  }
}
